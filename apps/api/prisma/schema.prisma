/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model lessons {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_id        String                   @db.Uuid
  title            String
  content_md       String?
  video_url        String?
  duration_seconds Int?
  position         Int                      @default(1)
  embedding        Unsupported("vector")?
  search_tsv       Unsupported("tsvector")?
  lesson_assets    lesson_assets[]
  course_modules   course_modules           @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  progress         progress[]
  quizzes          quizzes[]

  @@unique([module_id, position], map: "uq_lesson_position")
  @@index([embedding], map: "hnsw_lessons_embedding")
  @@index([search_tsv], map: "idx_lessons_fts", type: Gin)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model message_attachments {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message_id       String           @db.Uuid
  url              String
  mime_type        String?
  size_bytes       BigInt?
  width            Int?
  height           Int?
  duration_seconds Int?
  checksum         String?
  storage          storage_provider @default(s3)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  messages         messages         @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([message_id], map: "idx_msg_attachments_msg")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model messages {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id     String                   @db.Uuid
  sender_id           String                   @db.Uuid
  type                message_type             @default(text)
  content             String?
  is_read             Boolean                  @default(false)
  reply_to_id         String?                  @db.Uuid
  embedding           Unsupported("vector")?
  search_tsv          Unsupported("tsvector")?
  metadata            Json                     @default("{}")
  created_at          DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                 @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime?                @db.Timestamptz(6)
  message_attachments message_attachments[]
  conversations       conversations            @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  last_message_of     conversations?           @relation("conversation_last_message")
  messages            messages?                @relation("messagesTomessages", fields: [reply_to_id], references: [id], onUpdate: NoAction)
  other_messages      messages[]               @relation("messagesTomessages")
  users               users                    @relation(fields: [sender_id], references: [id], onUpdate: NoAction)

  @@index([embedding], map: "hnsw_messages_embedding")
  @@index([conversation_id, created_at], map: "idx_messages_conv_time")
  @@index([search_tsv], map: "idx_messages_fts", type: Gin)
  @@index([sender_id], map: "idx_messages_sender")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notifications {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String            @db.Uuid
  type            notification_type
  subject_id      String?           @db.Uuid
  actor_id        String?           @db.Uuid
  project_id      String?           @db.Uuid
  payload         Json              @default("{}")
  channels        String[]          @db.Text
  is_read         Boolean           @default(false)
  emailed_at      DateTime?         @db.Timestamptz(6)
  digest_key      String?
  idempotency_key String?           @unique
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  users           users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_notifications_user_created")
  @@index([user_id, is_read, created_at(sort: Desc)], map: "idx_notifications_user_unread")
}

model notification_preferences {
