generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model agg_daily_metrics {
  day              DateTime @id @db.Date
  dau              Int?
  new_users        Int?
  messages_sent    Int?
  projects_created Int?
  revenue_cents    BigInt?
  data             Json     @default("{}")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model assistant_cache {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cache_key       String                 @unique
  payload         Json                   @default("{}")
  query_embedding Unsupported("halfvec(1024)")?
  created_at      DateTime               @default(now()) @db.Timestamptz(6)
  last_used_at    DateTime               @default(now()) @db.Timestamptz(6)

  @@index([query_embedding], map: "hnsw_assistant_cache_query")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model assistant_sessions {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String?        @db.Uuid
  conversation_id String?        @db.Uuid
  started_at      DateTime       @default(now()) @db.Timestamptz(6)
  ended_at        DateTime?      @db.Timestamptz(6)
  metadata        Json           @default("{}")
  conversations   conversations? @relation(fields: [conversation_id], references: [id], onUpdate: NoAction)
  users           users?         @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_log {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_user_id String?  @db.Uuid
  action        String
  entity_type   String
  entity_id     String?  @db.Uuid
  before        Json?
  after         Json?
  ip_address    String?  @db.Inet
  user_agent    String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  users         users?   @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)

  @@index([actor_user_id], map: "idx_audit_actor")
  @@index([entity_type, entity_id], map: "idx_audit_entity")
}

model auth_identities {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String   @db.Uuid
  provider         String
  provider_user_id String
  email            String?  @db.Citext
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  users            users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, provider_user_id])
  @@index([user_id], map: "idx_auth_identities_user")
}

model email_verification_tokens {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  email       String    @db.Citext
  token_hash  String
  expires_at  DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_email_verification_user")
  @@index([email], map: "idx_email_verification_email")
}

model user_security_settings {
  user_id               String                  @id @db.Uuid
  totp_secret_encrypted String?
  totp_secret_iv        String?
  totp_secret_tag       String?
  totp_enabled          Boolean                 @default(false)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  users                 users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  backup_codes          user_totp_backup_codes[]
}

model user_totp_backup_codes {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  code_hash  String
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  security   user_security_settings @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_user_totp_codes_user")
}

model badges {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String        @unique @db.Citext
  name        String
  description String?
  icon_url    String?
  criteria    Json          @default("{}")
  user_badges user_badges[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model billing_webhook_events {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider         String    @default("stripe")
  event_id         String    @unique
  received_at      DateTime  @default(now()) @db.Timestamptz(6)
  payload          Json
  processed_at     DateTime? @db.Timestamptz(6)
  processing_error String?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model challenges {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  description   String?
  status        challenge_status @default(upcoming)
  starts_at     DateTime?        @db.Timestamptz(6)
  ends_at       DateTime?        @db.Timestamptz(6)
  points_reward Int?
  rules         Json             @default("{}")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model conversation_participants {
  conversation_id String        @db.Uuid
  user_id         String        @db.Uuid
  last_read_at    DateTime?     @db.Timestamptz(6)
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([conversation_id, user_id])
  @@index([user_id], map: "idx_conv_members_user")
  @@map("conversation_members")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model conversations {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                 conversation_type      @default(group)
  project_id           String?                @db.Uuid
  title                String?
  created_by           String                 @db.Uuid
  last_message_at      DateTime?              @db.Timestamptz(6)
  messages_count       BigInt                 @default(0)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  assistant_sessions   assistant_sessions[]
  participants         conversation_participants[]
  users                users                  @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  projects             projects?              @relation(fields: [project_id], references: [id], onUpdate: NoAction)
  messages             messages[]
  last_message_id      String?                @db.Uuid @unique
  last_message         messages?              @relation("conversation_last_message", fields: [last_message_id], references: [id])

  @@index([project_id], map: "idx_conversations_project")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model course_modules {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id String    @db.Uuid
  title     String
  position  Int       @default(1)
  courses   courses   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lessons   lessons[]

  @@unique([course_id, position], map: "uq_course_module_position")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model courses {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id      String                   @db.Uuid
  title          String
  description    String?
  level          course_level             @default(beginner)
  category       String?
  published      Boolean                  @default(false)
  published_at   DateTime?                @db.Timestamptz(6)
  visibility     visibility               @default(public)
  embedding      Unsupported("halfvec(1024)")?
  search_tsv     Unsupported("tsvector")?
  created_at     DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at     DateTime                 @default(now()) @db.Timestamptz(6)
  course_modules course_modules[]
  users          users                    @relation(fields: [author_id], references: [id], onUpdate: NoAction)
  enrollments    enrollments[]
  quizzes        quizzes[]

  @@index([embedding], map: "hnsw_courses_embedding")
  @@index([author_id], map: "idx_courses_author")
  @@index([search_tsv], map: "idx_courses_fts", type: Gin)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model enrollments {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String            @db.Uuid
  course_id    String            @db.Uuid
  status       enrollment_status @default(active)
  enrolled_at  DateTime          @default(now()) @db.Timestamptz(6)
  completed_at DateTime?         @db.Timestamptz(6)
  courses      courses           @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, course_id], map: "uq_enrollment_once")
}

model entitlements {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscription_id String         @db.Uuid
  feature_code    String         @db.Citext
  limit_value     Int?
  used_value      Int            @default(0)
  reset_every     reset_interval @default(month)
  expires_at      DateTime?      @db.Timestamptz(6)
  subscriptions   subscriptions  @relation(fields: [subscription_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([subscription_id, feature_code], map: "uq_entitlement_feature")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model event_registrations {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id      String              @db.Uuid
  user_id       String              @db.Uuid
  status        registration_status @default(registered)
  registered_at DateTime            @default(now()) @db.Timestamptz(6)
  attended      Boolean?
  attendance_at DateTime?           @db.Timestamptz(6)
  events        events              @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([event_id, user_id], map: "uq_event_registration_once")
  @@index([user_id], map: "idx_event_registrations_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model event_sessions {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id     String   @db.Uuid
  title        String
  description  String?
  starts_at    DateTime @db.Timestamptz(6)
  ends_at      DateTime @db.Timestamptz(6)
  speaker_id   String?  @db.Uuid
  speaker_name String?
  room         String?
  events       events   @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users?   @relation(fields: [speaker_id], references: [id], onUpdate: NoAction)

  @@index([event_id], map: "idx_event_sessions_event")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model events {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizer_id        String                   @db.Uuid
  title               String
  description         String?
  starts_at           DateTime                 @db.Timestamptz(6)
  ends_at             DateTime                 @db.Timestamptz(6)
  location_kind       location_type            @default(online)
  location_text       String?
  meeting_url         String?
  capacity            Int?
  visibility          visibility               @default(public)
  embedding           Unsupported("halfvec(1024)")?
  search_tsv          Unsupported("tsvector")?
  created_at          DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                 @default(now()) @db.Timestamptz(6)
  event_registrations event_registrations[]
  event_sessions      event_sessions[]
  users               users                    @relation(fields: [organizer_id], references: [id], onUpdate: NoAction)

  @@index([embedding], map: "hnsw_events_embedding")
  @@index([search_tsv], map: "idx_events_fts", type: Gin)
  @@index([organizer_id], map: "idx_events_org")
  @@index([starts_at, ends_at], map: "idx_events_time")
}

model financial_metrics {
  day                   DateTime @id @db.Date
  mrr_cents             BigInt?
  arr_cents             BigInt?
  arpu_cents            BigInt?
  churn_rate            Decimal? @db.Decimal(6, 4)
  new_mrr_cents         BigInt?
  expansion_mrr_cents   BigInt?
  contraction_mrr_cents BigInt?
}

model interests {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String                 @unique @db.Citext
  category       String?
  slug           String?                @unique @db.Citext
  embedding      Unsupported("halfvec(1024)")?
  user_interests user_interests[]
  project_interests project_interests[]

  @@index([embedding], map: "hnsw_interests_embedding")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model invoices {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscription_id     String         @db.Uuid
  billing_customer_id String?        @db.Uuid
  amount_cents        Int
  currency            String         @default("EUR") @db.Char(3)
  status              invoice_status @default(open)
  issued_at           DateTime       @default(now()) @db.Timestamptz(6)
  due_at              DateTime?      @db.Timestamptz(6)
  paid_at             DateTime?      @db.Timestamptz(6)
  external_invoice_id String?
  pdf_url             String?
  stripe_invoice_id   String?        @unique
  number              String?        @db.Citext
  subtotal_cents      Int?
  tax_amount_cents    Int?
  tax_rate_percent    Decimal?       @db.Decimal(5, 2)
  total_cents         Int?
  footer              String?
  legal_mention       String?
  subscriptions       subscriptions  @relation(fields: [subscription_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  billing_customers   billing_customers? @relation(fields: [billing_customer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  payments            billing_payments[]

  @@index([billing_customer_id], map: "idx_invoices_billing_customer")
  @@index([subscription_id], map: "idx_invoices_subscription")
}

model organizations {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  legal_name        String
  legal_form        String               @default("SAS")
  siren             String?
  siret             String?
  rcs               String?
  vat_number        String?
  address           Json?
  billing_email     String?
  phone             String?
  website           String?
  owner_id          String?              @db.Uuid
  metadata          Json                 @default("{}")
  created_at        DateTime             @default(now()) @db.Timestamptz(6)
  updated_at        DateTime             @default(now()) @db.Timestamptz(6)
  billing_customers billing_customers[]
  subscriptions     subscriptions[]
  owner             users?               @relation("organization_owner", fields: [owner_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([owner_id], map: "idx_organizations_owner")
}

model billing_customers {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String?           @db.Uuid
  user_id            String?           @db.Uuid
  stripe_customer_id String            @unique
  email              String            @db.Citext
  name               String?
  phone              String?
  locale             String?           @default("fr")
  tax_exemption      String?           @db.Citext
  vat_number         String?
  vat_valid          Boolean           @default(false)
  billing_address    Json?
  shipping_address   Json?
  metadata           Json              @default("{}")
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime          @default(now()) @db.Timestamptz(6)
  organization       organizations?    @relation(fields: [organization_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user               users?            @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  subscriptions      subscriptions[]
  invoices           invoices[]
  payments           billing_payments[]

  @@index([organization_id], map: "idx_billing_customer_org")
  @@index([user_id], map: "idx_billing_customer_user")
}

model billing_payments {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billing_customer_id      String         @db.Uuid
  invoice_id               String?        @db.Uuid
  stripe_payment_intent_id String         @unique
  amount_cents             Int
  currency                 String         @default("EUR") @db.Char(3)
  status                   payment_status @default(succeeded)
  payment_method_type      String?
  receipt_url              String?
  processed_at             DateTime?      @db.Timestamptz(6)
  created_at               DateTime       @default(now()) @db.Timestamptz(6)
  updated_at               DateTime       @default(now()) @db.Timestamptz(6)
  billing_customer         billing_customers @relation(fields: [billing_customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoice                  invoices?      @relation(fields: [invoice_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([invoice_id], map: "idx_billing_payments_invoice")
  @@index([billing_customer_id, processed_at], map: "idx_billing_payments_customer")
}

model billing_events {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stripe_event_id String   @unique
  type            String
  payload         Json
  processed       Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  processed_at    DateTime? @db.Timestamptz(6)
  error_message   String?
}

model billing_invoice_sequences {
  id         Int      @id @default(autoincrement())
  year       Int
  last_value Int      @default(0)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([year], map: "uq_invoice_sequence_year")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model jobs {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queue      String
  job_type   String
  status     job_status @default(queued)
  priority   Int        @default(0)
  run_at     DateTime?  @db.Timestamptz(6)
  attempts   Int        @default(0)
  last_error String?
  payload    Json       @default("{}")
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)

  @@index([queue, status, run_at], map: "idx_jobs_queue_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model lesson_assets {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lesson_id  String     @db.Uuid
  type       asset_type
  title      String?
  url        String
  size_bytes BigInt?
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  lessons    lessons    @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lesson_id], map: "idx_lesson_assets_lesson")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model lessons {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_id        String                   @db.Uuid
  title            String
  content_md       String?
  video_url        String?
  duration_seconds Int?
  position         Int                      @default(1)
  embedding        Unsupported("halfvec(1024)")?
  search_tsv       Unsupported("tsvector")?
  lesson_assets    lesson_assets[]
  course_modules   course_modules           @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  progress         progress[]
  quizzes          quizzes[]

  @@unique([module_id, position], map: "uq_lesson_position")
  @@index([embedding], map: "hnsw_lessons_embedding")
  @@index([search_tsv], map: "idx_lessons_fts", type: Gin)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model message_attachments {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message_id       String           @db.Uuid
  url              String
  mime_type        String?
  size_bytes       BigInt?
  width            Int?
  height           Int?
  duration_seconds Int?
  checksum         String?
  storage          storage_provider @default(s3)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  messages         messages         @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([message_id], map: "idx_msg_attachments_msg")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model messages {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id     String                   @db.Uuid
  sender_id           String                   @db.Uuid
  type                message_type             @default(text)
  content             String?
  is_read             Boolean                  @default(false)
  reply_to_id         String?                  @db.Uuid
  embedding           Unsupported("halfvec(1024)")?
  search_tsv          Unsupported("tsvector")?
  metadata            Json                     @default("{}")
  created_at          DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                 @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime?                @db.Timestamptz(6)
  message_attachments message_attachments[]
  conversations       conversations            @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  last_message_of     conversations?           @relation("conversation_last_message")
  messages            messages?                @relation("messagesTomessages", fields: [reply_to_id], references: [id], onUpdate: NoAction)
  other_messages      messages[]               @relation("messagesTomessages")
  users               users                    @relation(fields: [sender_id], references: [id], onUpdate: NoAction)

  @@index([embedding], map: "hnsw_messages_embedding")
  @@index([conversation_id, created_at], map: "idx_messages_conv_time")
  @@index([search_tsv], map: "idx_messages_fts", type: Gin)
