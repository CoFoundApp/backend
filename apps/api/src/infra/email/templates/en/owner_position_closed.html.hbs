{{#> layout}}
  <p>Hi,</p>
  <p>The position <strong>{{position_title}}</strong> on <strong>{{project_title}}</strong> has been closed.</p>
  {{#if status}}<p><strong>Status:</strong> {{status}}</p>{{/if}}
