{{#> layout}}
  <p>Hi, {{owner_name}}</p>

  <p>{{applicant_name}} has withdrawn their application for your project <strong>{{project_name}}</strong>.</p>

  {{#if position_name}}
    <p><strong>Position:</strong> {{position_name}}</p>
  {{/if}}

  <p><strong>Status:</strong> {{status}}</p>

  <p><a href="{{cta_url}}" class="btn">View applications</a></p>

  <p>Cheers,<br/>The {{app_name}} Team</p>
{{/layout}}
