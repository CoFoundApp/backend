{{#> layout}}
  <p>Hi, {{owner_name}}</p>

  <p>You have a new application for your project <strong>{{project_name}}</strong>.</p>

  <p><strong>Applicant:</strong> {{applicant_name}}</p>

  {{#if position_name}}
