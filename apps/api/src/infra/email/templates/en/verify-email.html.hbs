{{#> layout}}
  <p>Hello,</p>
  {{#if is_email_change}}
    <p>You requested to update the email address associated with your {{brand_name}} account. Please confirm this change by clicking the button below.</p>
  {{else}}
    <p>Thank you for joining {{brand_name}}! Please confirm your email address to secure your account.</p>
  {{/if}}
  <p style="text-align:center;">
    <a href="{{verification_url}}" style="display:inline-block;padding:12px 24px;background-color:#1a56db;color:#ffffff;border-radius:6px;text-decoration:none;font-weight:600;">
      Confirm my email
    </a>
  </p>
  <p>If the button does not work, copy and paste this link into your browser:<br />
    <a href="{{verification_url}}">{{verification_url}}</a>
  </p>
  <p>This link expires on {{expires_at_iso}}.</p>
  <p>If you did not request this {{#if is_email_change}}change{{else}}verification{{/if}}, please ignore this email or contact support immediately.</p>
{{/layout}}
