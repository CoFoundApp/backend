{{#> layout}}
  <p>Hi, {{applicant_name}}</p>

  <p>Your application to <strong>{{project_name}}</strong> has been <strong>canceled</strong> by the project owner.</p>

  {{#if position_name}}
    <p><strong>Position:</strong> {{position_name}}</p>
  {{/if}}

  <p><strong>Status:</strong> {{status}}</p>

  <p>If you believe this is a mistake or need more details, please contact support.</p>

  <p>Cheers,<br/>The {{app_name}} Team</p>
{{/layout}}
