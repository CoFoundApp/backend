{{#> layout}}
  <p>Hello,</p>
  <p>We received a request to reset the password for your {{brand_name}} account{{#if email}} ({{email}}){{/if}}. Click the button below to choose a new password.</p>
  <p style="text-align:center;">
    <a href="{{reset_url}}" style="display:inline-block;padding:12px 24px;background-color:#1a56db;color:#ffffff;border-radius:6px;text-decoration:none;font-weight:600;">
      Reset my password
    </a>
  </p>
  <p>If the button does not work, copy and paste this link into your browser:<br />
    <a href="{{reset_url}}">{{reset_url}}</a>
  </p>
  <p>This link expires on {{expires_at_iso}}.</p>
  <p>If you did not request a password reset, you can safely ignore this message.</p>
{{/layout}}
