{{#> layout }}
  <p>Bonjour{{#if customer_name}} {{customer_name}}{{/if}},</p>
  <p>Nous confirmons la réception d'un paiement de {{amount_formatted}} pour votre facture {{#if invoice_number}}<strong>{{invoice_number}}</strong>{{else}}CoFound{{/if}}.</p>
  {{#if payment_method}}
    <p>Moyen de paiement : {{payment_method}}.</p>
  {{/if}}
  {{#if receipt_url}}
    <p>Le reçu est disponible <a href="{{receipt_url}}">via ce lien</a>.</p>
  {{/if}}
  {{#if invoice_url}}
    <p>Vous pouvez consulter la facture <a href="{{invoice_url}}">en ligne</a>{{#if pdf_url}} ou <a href="{{pdf_url}}">télécharger le PDF</a>{{/if}}.</p>
  {{else if pdf_url}}
    <p>Vous pouvez télécharger le PDF de la facture <a href="{{pdf_url}}">en cliquant ici</a>.</p>
  {{/if}}
  <p>Merci pour votre confiance.<br/>L'équipe CoFound</p>
{{/layout}}
