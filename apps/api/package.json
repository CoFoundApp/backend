{
  "name": "@cofound/api",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build && cpx \"src/infra/email/templates/**/*\" dist/infra/email/templates",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:pull": "prisma db pull --schema ./prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema ./prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema ./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema ./prisma/schema.prisma",
    "seed:admin": "node ./dist/scripts/seed-admin.js",
    "test": "cross-env NODE_ENV=test jest --passWithNoTests",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:e2e": "cross-env NODE_ENV=test jest --config ./jest-e2e.json"
  },
  "dependencies": {
    "@mistralai/mistralai": "^1.9.18",
    "@apollo/server": "^4.12.2",
    "@nestjs/apollo": "^13",
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11",
    "@nestjs/graphql": "^13",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11",
    "@nestjs/platform-socket.io": "^11",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11",
    "@prisma/client": "6.15.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/compression": "^1.8.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/passport-jwt": "^4.0.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "cookie": "^1.0.2",
    "express": "^5.1.0",
    "graphql": "^16.11",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@mistralai/mistralai": "^1.9.18",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/schematics": "^10.1.2",
    "@nestjs/testing": "^11.1.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.7.0",
    "@types/nodemailer": "^7.0.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "cookie-parser": "^1.4.7",
    "cpx": "^1.5.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-upload-ts": "^2.1.2",
    "handlebars": "^4.7.8",
    "jest": "^30.0.5",
    "nodemailer": "^7.0.6",
    "prisma": "6.15.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
