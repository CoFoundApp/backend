{
  "name": "cofound",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --filter \"./apps/*\" dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "lint": "pnpm -r --filter \"./apps/*\" lint",
    "format": "prettier -w \"**/*.{ts,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.2"
  }
}
