# API
PORT=3000

# Postgres (utilisés aussi par DATABASE_URL)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=cofound
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/cofound?schema=public

# Redis
REDIS_URL=redis://redis:6379

# JWT (placeholder)
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_TTL=30d

# Embeddings
EMBEDDING_DIMS=1536
