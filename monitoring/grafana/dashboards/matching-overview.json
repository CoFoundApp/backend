{
  "id": null,
  "uid": "matching-overview",
  "title": "Matching & Queue Overview",
  "tags": ["cofound", "matching"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Matching requests per minute",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (target, mode, status)(rate(cofound_matching_requests_total[5m]))",
          "legendFormat": "{{target}} {{mode}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Matching duration p90 (s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.9, sum by (le, target, mode)(rate(cofound_matching_duration_seconds_bucket[5m])))",
          "legendFormat": "{{target}} {{mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Queue depth",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "sum by (queue, status)(cofound_queue_jobs)",
          "legendFormat": "{{queue}} {{status}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal"
      }
    },
    {
      "type": "timeseries",
      "title": "Queue processing duration p95 (s)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, queue, job)(rate(cofound_queue_job_duration_seconds_bucket[5m])))",
          "legendFormat": "{{queue}} {{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      }
    }
  ]
}
